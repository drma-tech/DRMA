@using Microsoft.JSInterop

@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IJSRuntime JsRuntime

@if (_processing)
{
    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Style="position: fixed; z-index: 1400;" />
}
<MudAppBar Fixed="true" Elevation="1" Color="Color.Dark">
    @if (AppStateStatic.Breakpoint == Breakpoint.Xs) //mobile view
    {
        <MudButton StartIcon="@Icons.Material.Filled.House" Color="@GetColor($"/{Culture}")" Href=@($"/{Culture}") Variant="@GetVariant($"/{Culture}")" Class="icon-text-button">
            Home
        </MudButton>

        <MudSpacer />

        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => { _openMenu = true; })" />
    }
    else if (AppStateStatic.Breakpoint == Breakpoint.Sm) //tablet view
    {
        <MudButton StartIcon="@Icons.Material.Filled.House" Color="@GetColor($"/{Culture}")" Href=@($"/{Culture}") Variant="@GetVariant($"/{Culture}")" Class="icon-text-button">
            Home
        </MudButton>

        <MudSpacer />

        <MudIconButton Variant="Variant.Filled" Color="Color.Primary" Icon="@Icons.Material.Filled.Settings" Class="me-2" OnClick="@OpenConfigurations" />
        <MudIconButton Variant="Variant.Filled" Color="Color.Primary" Icon="@Icons.Material.Filled.HelpCenter" Class="me-2" OnClick="@(() => Navigation.NavigateTo($"/{Culture}/help"))" />
    }
    else //desktop view
    {
        <MudButton StartIcon="@Icons.Material.Filled.House" Color="@GetColor($"/{Culture}")" Href=@($"/{Culture}") Variant="@GetVariant($"/{Culture}")" Class="px-3">
            Home
        </MudButton>

        <MudSpacer />

        <MudIconButton Variant="Variant.Filled" Color="Color.Primary" Icon="@Icons.Material.Filled.Settings" Class="me-2" OnClick="@OpenConfigurations" />
        <MudIconButton Variant="Variant.Filled" Color="Color.Primary" Icon="@Icons.Material.Filled.HelpCenter" Class="me-2" OnClick="@(() => Navigation.NavigateTo($"/{Culture}/help"))" />
    }
</MudAppBar>

@if (AppStateStatic.Breakpoint <= Breakpoint.Xs) //mobile menu
{
    <MudDrawer @bind-Open="@_openMenu" Anchor="Anchor.Right" Elevation="1" OverlayAutoClose="true">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">@AppInfo.Title</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Icon="@Icons.Material.Filled.Settings" OnClick="@OpenConfigurations">
                Settings
            </MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.HelpCenter" Href=@($"/{Culture}/help")>
                Help Center
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>
}