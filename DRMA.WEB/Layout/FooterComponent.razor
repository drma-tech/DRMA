@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<MudDivider Class="@CssHelper.Build().Small("mb").Raw("mt-10")"></MudDivider>
<MudGrid Justify="Justify.Center" Style="overflow: auto;" Spacing="@CssHelper.SpaceSmall">
    <MudItem xs="6" sm="3" md="2">
        <MudList T="string" Dense="true" Gutters="false">
            <MudListSubheader Gutters="false">
                <MudText Color="Color.Secondary">
                    About
                </MudText>
            </MudListSubheader>
            <MudListItem Text="About us" Href=@($"/{Culture}/company/about-us") Class="py-0" rel="nofollow" />
        </MudList>
    </MudItem>
    <MudItem xs="6" sm="3" md="2">
        <MudList T="string" Dense="true" Gutters="false">
            <MudListSubheader Gutters="false">
                <MudText Color="Color.Secondary">
                    Support
                </MudText>
            </MudListSubheader>
            <MudListItem Text="@Translations.Title.HelpCenter" Href=@($"/{Culture}/help") Class="py-0" />
            <MudListItem Text="Contact" Href="mailto:contact@drma-tech.com" Class="py-0" rel="nofollow" />
        </MudList>
    </MudItem>
</MudGrid>

<style>
    .mud-list-item-avatar {
        min-width: 40px;
    }
</style>
