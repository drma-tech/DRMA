@page "/{culture}/help"
@inherits PageCore<HelpCenterPage>

<HeadComponent Title="@Translations.Title.HelpCenter" Description="@Translations.Description.HelpCenter.CustomFormat(AppInfo.Title)" Url=@($"/{Culture}/help") Index="true"></HeadComponent>
<PageSectionComponent IsPageHeader="true" Title="@Translations.Title.HelpCenter" Description="@Translations.Description.HelpCenter.CustomFormat(AppInfo.Title)"></PageSectionComponent>

<PageSectionComponent Title="Troubleshooting">
    <BodyFragment>
        <MudGrid Spacing="@CssHelper.SpaceSmall">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudButton Variant="Variant.Filled" FullWidth="true" OnClick="@ShowCacheClick">
                    <MudIcon Class="me-2" Icon="@Icons.Material.Filled.Memory"></MudIcon>
                    @Translations.Button.ShowCache
                </MudButton>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudButton Variant="Variant.Filled" FullWidth="true" OnClick="@ClearCacheClick">
                    <MudIcon Class="me-2" Icon="@Icons.Material.Filled.Clear"></MudIcon>
                    @Translations.Button.ClearCache
                </MudButton>
            </MudItem>
        </MudGrid>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="@Translations.Module.Help.AppLanguage">
    <BodyFragment>
        <MudGrid Spacing="@CssHelper.SpaceSmall">
            @foreach (var lang in EnumHelper.GetList<AppLanguage>().Where(p => ConfigurationsStatic.SitemapTranslations.Contains(p.Value.ToString())))
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudButton Variant="Variant.Filled" FullWidth="true" Href="@($"/{lang.Value.ToString()}/help")" OnClick="@(() => AppLanguageClick(lang.Value))">
                        <MudIcon Class="me-2" Icon="@Icons.Material.Filled.Translate"></MudIcon>
                        @lang.Name
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Company">
    <BodyFragment>
        <MudGrid Spacing="@CssHelper.SpaceSmall">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudButton Variant="Variant.Filled" FullWidth="true" Href=@($"/{Culture}/company/about-us") rel="nofollow">
                    <MudIcon Class="me-2" Icon="@Icons.Material.Filled.Business"></MudIcon>
                    About us
                </MudButton>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudButton Variant="Variant.Filled" FullWidth="true" Href="mailto:contact@drma-tech.com" rel="nofollow">
                    <MudIcon Class="me-2" Icon="@Icons.Material.Filled.Email"></MudIcon>
                    Contact us
                </MudButton>
            </MudItem>
        </MudGrid>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="More from DRMA Tech">
    <BodyFragment>
        <MudGrid Spacing="@CssHelper.SpaceSmall">
            @foreach (var product in AppInfo.Products)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudButton Variant="Variant.Filled" FullWidth="true" Href="@product.Url" Target="_blank" rel="noopener">
                        <MudImage Src="@product.Logo" Class="me-2" Style="width: 20px; vertical-align: top;" Alt="@product.Title" />
                        @product.Title
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </BodyFragment>
</PageSectionComponent>
