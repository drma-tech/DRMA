@page "/{culture}"

<HeadComponent Title="@($"{AppInfo.Title} - {AppInfo.Subtitle}")" Description="DRMA Tech builds digital tools that help people discover options that fit their needs and make more informed decisions." Url=@($"/{Culture}") Index="@Culture.NotEmpty()" Shared="true" />

@inherits PageCore<Index>

<MudContainer>
    <MudGrid Spacing="@CssHelper.SpaceSmall" Class="mb-20" Style="align-items: center;">
        <MudItem xs="12" sm="6" Style="text-align: center;">
            <MudPaper Elevation="2" Class="ma-8 pa-8">
                <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-2">
                    DRMA Tech
                </MudText>
                <MudText Typo="Typo.body1" Align="Align.Justify">
                    DRMA Tech builds digital tools that help people discover options that fit their needs and make more informed decisions.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" Style="text-align: center;">
            <MudImage Src="icon/icon-full-small.png" Alt="DRMA Tech" Style="width: 50%;" fetchpriority=high />
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h5" Color="Color.Primary">
        Our Products
    </MudText>
    <MudDivider Class="mb-10"></MudDivider>
    <MudGrid Spacing="@CssHelper.SpaceLarge" Class="mb-20">
        <MudItem xs="12" sm="4" Style="align-content: center;">
            <MudText Typo="Typo.h6" Color="Color.Secondary" Align="Align.Center" Class="mb-2">
                Tools to Help You Find the Right Fit
            </MudText>
            <MudText Typo="Typo.body1" Align="Align.Justify" Style="line-height: 1.6;">
                Our apps help you discover options that fit your interests and needs, from movies and travel destinations to compatible partners. We also build practical tools that make working with the web easier.
            </MudText>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="2" Class="mb-10 pa-4">
                <div class="d-flex mb-2">
                    <MudImage Src="logo/streamingdiscovery.png" Height="50" Class="me-2" Alt="Streaming Discovery"></MudImage>
                    <MudText Typo="Typo.h6" Color="Color.Secondary" Style="align-content: center;">
                        Streaming Discovery
                    </MudText>
                </div>
                <div>
                    <MudLink Href="https://streamingdiscovery.com" Target="_blank" Underline="Underline.Always">
                        streamingdiscovery.com
                    </MudLink>
                </div>
                <MudText Typo="Typo.body2" Align="Align.Justify" Style="line-height: 1.6;">
                    Manage your streaming services and keep track of what you've watched. Discover what to watch next with curated lists, award-winning films, critics' picks, and hidden gems.
                </MudText>
                <MudAlert Variant="Variant.Outlined" Severity="Severity.Info" Dense="true" Class="mt-3">
                    In operation since 2021
                </MudAlert>
            </MudPaper>
            <MudPaper Elevation="2" Class="mb-10 pa-4">
                <div class="d-flex mb-2">
                    <MudImage Src="logo/next-spot.png" Height="50" Class="me-2" Alt="My Next Spot"></MudImage>
                    <MudText Typo="Typo.h6" Color="Color.Secondary" Style="align-content: center;">
                        My Next Spot
                    </MudText>
                </div>
                <div>
                    <MudLink Href="https://my-next-spot.com" Target="_blank" Underline="Underline.Always">
                        my-next-spot.com
                    </MudLink>
                </div>
                <MudText Typo="Typo.body2" Align="Align.Justify" Style="line-height: 1.6;">
                    Explore countries and cities, learn interesting facts, and create your profile to find destinations that match your lifestyle, whether for a trip or a new home.
                </MudText>
                <MudAlert Variant="Variant.Outlined" Severity="Severity.Success" Dense="true" Class="mt-3">
                    App launched in February 2026
                </MudAlert>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="2" Class="mb-10 pa-4">
                <div class="d-flex mb-2">
                    <MudImage Src="logo/modern-matchmaker.png" Height="50" Class="me-2" Alt="Modern Matchmaker"></MudImage>
                    <MudText Typo="Typo.h6" Color="Color.Secondary" Style="align-content: center;">
                        Modern Matchmaker
                    </MudText>
                </div>
                <div>
                    <MudLink Href="https://modern-matchmaker.com" Target="_blank" Underline="Underline.Always">
                        modern-matchmaker.com
                    </MudLink>
                </div>
                <MudText Typo="Typo.body2" Align="Align.Justify" Style="line-height: 1.6;">
                    Our compatibility system helps you find a partner who shares your values, with a more affordable and focused approach than traditional matchmaking.
                </MudText>
                <MudAlert Variant="Variant.Outlined" Severity="Severity.Success" Dense="true" Class="mt-3">
                    App launched in September 2025
                </MudAlert>
            </MudPaper>
            <MudPaper Elevation="2" Class="mb-10 pa-4">
                <div class="d-flex mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Bed" Color="Color.Secondary" Class="me-2" Style="height: 50px; width: 50px;"></MudIcon>
                    <MudText Typo="Typo.h6" Color="Color.Secondary" Style="align-content: center;">
                        Rent a Room
                    </MudText>
                </div>
                <MudAlert Variant="Variant.Outlined" Severity="Severity.Normal" Dense="true" Class="mt-3">
                    Coming soon
                </MudAlert>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>
