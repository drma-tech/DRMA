@using Microsoft.JSInterop
@inject IJSRuntime JsRuntime

@if (Visible)
{
    <div class="@BodyClass">
        @if (IsPageHeader)
        {
            <MudPaper Class="@CssHelper.Build().Small("pa")" Style="@($"background-color: transparent; {(HasActions ? "border-radius: 4px 4px 0px 0px;" : "")}")" Outlined="true" Elevation="0">
                <MudToolBar WrapContent="true" Gutters="false" Style="min-height: auto;">
                    @if (!string.IsNullOrEmpty(Icon))
                    {
                        <MudIcon Icon="@Icon" Class="me-2" Color="Color" Style="@($"font-size: {headerImageSize} !important; width: auto;")"></MudIcon>
                    }
                    else if (!string.IsNullOrEmpty(Image))
                    {
                        <MudImage Src="@Image" Class="me-2" Style="@GetImageStyle(true)" Alt="@Image"></MudImage>
                    }
                    @if (AppStateStatic.IsMobile)
                    {
                        <MudText Typo="Typo.h1" Color="Color" Style="@($"font-size: {titleFontSize}; line-height: 1.2;")" id="@Title.ToSlug()">
                            @Title
                        </MudText>
                        @if (Subtitle.NotEmpty())
                        {
                            <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Style="@($"font-size: {subtitleFontSize}; line-height: 1.2; width: 100%;")" Class="mt-1">
                                @Subtitle
                            </MudText>
                        }
                    }
                    else
                    {
                        <div>
                            <MudText Typo="Typo.h1" Color="Color" Style="@($"font-size: {titleFontSize}; line-height: 1.2;")" id="@Title.ToSlug()">
                                @Title
                            </MudText>
                            @if (Subtitle.NotEmpty())
                            {
                                <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Style="@($"font-size: {subtitleFontSize}; line-height: 1.2;")">
                                    @Subtitle
                                </MudText>
                            }
                        </div>
                    }
                    @if (Link.NotEmpty())
                    {
                        <MudSpacer />
                        <MudTooltip Text="Official Website">
                            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Link" Href="@Link" Target="_blank" Rel="noopener" Size="Size.Medium" />
                        </MudTooltip>
                    }
                </MudToolBar>
                @if (Description.NotEmpty())
                {
                    <div style="text-align: justify;" class="@CssHelper.Build().Small("mt")">
                        <MudText Style="@($"line-height: {(AppStateStatic.IsMobile ? "1.0" : "1.2")}; letter-spacing: {(AppStateStatic.IsMobile ? "normal" : "inherit")}; font-size: 0.9rem;")">
                            @Description
                        </MudText>
                    </div>
                }
            </MudPaper>
            @if (ExtraFragment != null)
            {
                <MudPaper Class="@CssHelper.Build().Small("pa")" Style="@($"background-color: transparent; {(HasActions ? "border-radius: 0px 0px 0px 0px;" : "")}")" Outlined="true" Elevation="0">
                    @ExtraFragment
                </MudPaper>
            }
            @if (ShowActions && (HasActions || UrlShare.NotEmpty()))
            {
                <MudPaper Class="@CssHelper.Build().Small("pa")" Style="@($"background-color: transparent; {(HasActions ? "border-radius: 0px 0px 4px 4px;" : "")}")" Outlined="true" Elevation="0">
                    <MudToolBar WrapContent="true" Dense="true" Gutters="false" Style="min-height: auto;">
                        @ActionsFragment
                        @if (UrlShare.NotEmpty())
                        {
                            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Share"
                                       OnClick="@(() => JsRuntime.Utils().Share(Title, Description, AbsolutelUrl, CancellationToken.None))">
                                @Translations.Button.Share
                            </MudButton>
                        }
                    </MudToolBar>
                </MudPaper>
            }
        }
        else
        {
            @if (ShowHeader)
            {
                <div class="@CssHelper.Build().Small("mb")">
                    <MudToolBar WrapContent="true" Dense="true" Gutters="false" Style="min-height: auto;">
                        @if (!string.IsNullOrEmpty(Icon))
                        {
                            <MudIcon Icon="@Icon" Class="me-2" Color="Color" Style="@($"font-size: {sectionImageSize} !important; width: auto;")"></MudIcon>
                        }
                        else if (!string.IsNullOrEmpty(Image))
                        {
                            <MudImage Src="@Image" Class="me-2" Style="@GetImageStyle(false)" Alt="@Image"></MudImage>
                        }
                        @if (AppStateStatic.IsMobile)
                        {
                            <MudText Typo="Typo.h2" Color="Color" Style="@($"font-size: {titleFontSize}; line-height: 1.2;")" id="@Title.ToSlug()">
                                @Title
                            </MudText>
                            @if (Subtitle.NotEmpty())
                            {
                                <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Style="@($"font-size: {subtitleFontSize}; line-height: 1.2; width: 100%;")" Class="mt-1">
                                    @Subtitle
                                </MudText>
                            }
                        }
                        else
                        {
                            <div>
                                <MudText Typo="Typo.h2" Color="Color" Style="@($"font-size: {titleFontSize}; line-height: 1.2;")" id="@Title.ToSlug()">
                                    @Title
                                </MudText>
                                @if (Subtitle.NotEmpty())
                                {
                                    <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Style="@($"font-size: {subtitleFontSize}; line-height: 1.2;")">
                                        @Subtitle
                                    </MudText>
                                }
                            </div>
                        }
                        @if (Link.NotEmpty())
                        {
                            <MudSpacer />
                            <MudTooltip Text="Official Website">
                                <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Link" Href="@Link" Target="_blank" Rel="noopener" Size="Size.Medium" />
                            </MudTooltip>
                        }
                    </MudToolBar>
                    @if (Description.NotEmpty())
                    {
                        <div style="text-align: justify;" class="@CssHelper.Build().Small("mt")">
                            @* LCP breakdown -> variant font-size *@
                            <MudText Style="@($"line-height: {(AppStateStatic.IsMobile ? "1.0" : "1.2")}; letter-spacing: {(AppStateStatic.IsMobile ? "normal" : "inherit")}; font-size: 0.9rem;")">
                                @Description
                            </MudText>
                        </div>
                    }
                </div>
            }
            @if (ExtraFragment != null)
            {
                <MudPaper Class="@CssHelper.Build().Small("pa")" Style="@($"background-color: transparent; {(HasActions ? "border-radius: 0px 0px 0px 0px;" : "")}")" Outlined="true" Elevation="0">
                    @ExtraFragment
                </MudPaper>
            }
            @if (ShowActions && HasActions)
            {
                <MudPaper Class="@CssHelper.Build().Small("pa")" Style="@($"background-color: transparent; {(HasActions ? "border-radius: 4px 4px 0px 0px;" : "")}")" Outlined="true" Elevation="0">
                    <MudToolBar WrapContent="true" Dense="true" Gutters="false" Style="min-height: auto;">
                        @ActionsFragment
                    </MudToolBar>
                </MudPaper>
            }
            @if (HasBody)
            {
                @if (HasBodyBox)
                {
                    <MudPaper Class="@CssHelper.Build().Small("pa")" Style="@($"background-color: transparent; {(HasActions ? "border-radius: 0px 0px 4px 4px;" : "")}")" Outlined="true" Elevation="0">
                        @BodyFragment
                    </MudPaper>
                }
                else
                {
                    @BodyFragment
                }
            }
        }
    </div>
}