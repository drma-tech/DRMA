@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>@(FixedTitle ? Title : TitleFull)</PageTitle>

<HeadContent>

    @if (!Index)
    {
        <meta name="robots" content="noindex" />
    }

    <meta name="description" content="@Description" />

    <!-- Bing -->
    <meta http-equiv="content-language" content="@Culture?.ToLower()" />

    <link rel="canonical" href="@CanonicalUrl" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- hreflang -->
    @if (Index)
    {
        if (FixedAlternateLanguage.Empty())
        {
            foreach (var lang in ConfigurationsStatic.SitemapTranslations)
            {
                <link rel="alternate" href="@GetUrlForLanguage(lang)" hreflang="@lang" />
            }
        }
        else
        {
            <link rel="alternate" href="@GetUrlForLanguage(FixedAlternateLanguage)" hreflang="@FixedAlternateLanguage" />
        }
    }

    <!-- x-default -->
    @if (Index)
    {
        if (ConfigurationsStatic.SitemapTranslations.Length > 0)
        {
            <link rel="alternate" href="@GetUrlForLanguage(FixedAlternateLanguage ?? "en")" hreflang="x-default" />
        }
    }

    @if (Shared)
    {
        <link rel="image_src" href="@ImageUrl">

        <meta property="og:type" content="website" />
        <meta property="og:url" content="@CanonicalUrl" />
        <meta property="og:site_name" content="@AppInfo.Title" />
        <meta property="og:title" content="@TitleFull" />
        <meta property="og:description" content="@Description" />
        <meta property="og:image" content="@ImageUrl" />
    }

</HeadContent>

<script>
    window.setHtmlLang = function(lang) {
        document.documentElement.lang = lang;
    };
</script>
