<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>full</TrimMode>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<EnableNETAnalyzers>True</EnableNETAnalyzers>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BlazorWasmPreRendering.Build" Version="8.0.2" />
		<PackageReference Include="Meziantou.Analyzer" Version="3.0.224">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11">
			<TreatAsUsed>true</TreatAsUsed>
		</PackageReference>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.11" />
		<PackageReference Include="MudBlazor" Version="9.9.0" />
		<PackageReference Include="Sentry.AspNetCore.Blazor.WebAssembly" Version="6.10.0" />
		<PackageReference Include="Toolbelt.Blazor.PWA.Updater" Version="3.2.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\DRMA.Shared\DRMA.Shared.csproj" />
		<TrimmerRootAssembly Include="DRMA.WEB" />
		<TrimmerRootAssembly Include="DRMA.Shared" />
	</ItemGroup>
	<ItemGroup>
		<ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Translations\Button.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Button.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Translations\Description.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Description.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Translations\Module\Help.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Help.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Translations\Title.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Title.resx</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Update="Translations\Button.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>Button.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Translations\Description.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>Description.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Translations\Module\Help.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>Help.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Translations\Title.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>Title.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>
	<PropertyGroup>
		<BlazorWasmPrerenderingMode>Static</BlazorWasmPrerenderingMode>
		<BlazorWasmPrerenderingLocale>en,pt</BlazorWasmPrerenderingLocale>
		<BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
		<CurrentDate>$([System.DateTime]::Now.ToString(yyyy.MM.dd))</CurrentDate>
		<EnableNETAnalyzers>True</EnableNETAnalyzers>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
	</PropertyGroup>
	<Target Name="PreBuild" BeforeTargets="PreBuildEvent">
		<WriteLinesToFile File="$(ProjectDir)wwwroot\js\app-version.js" Lines="window.appVersion = '$(CurrentDate)';" Overwrite="true" />
	</Target>
	<Target Name="FixHtmlLangAttribute" BeforeTargets="_ProcessPublishFilesForBlazor">
		<Exec Condition="!$([MSBuild]::IsOSPlatform('WINDOWS'))" Command="bash &quot;$(MSBuildProjectDirectory)/FixHtmlLang.sh&quot; &quot;$(PublishDir)wwwroot&quot;" />
	</Target>
</Project>
